rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── pro_users collection ────────────────────────────────────────────────
    // Stores one document per device that purchased the pro version.
    // Document ID = deviceId generated by PurchaseService.getOrCreateDeviceId()
    match /pro_users/{deviceId} {

      // Anyone can READ their own document to restore/verify purchase status.
      // The device ID is the document ID, so only a device that already knows
      // its own ID can read it — there is no way to enumerate other users.
      allow read: if true;

      // WRITE is allowed only when:
      //   1. The document does not already exist (first-time purchase), OR
      //      it already belongs to this device (idempotent re-save on restore).
      //   2. The payload contains the required fields with the right types.
      //   3. No extra sensitive fields are injected by a malicious client.
      allow create: if isValidProUserPayload(request.resource.data);

      allow update: if
        // Device can only update its own document
        resource.data.deviceId == request.resource.data.deviceId
        && isValidProUserPayload(request.resource.data);

      // Deletes are forbidden — purchase records are permanent.
      allow delete: if false;
    }

    // ─── Everything else is denied by default ────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ─── Helper function ─────────────────────────────────────────────────────────
function isValidProUserPayload(data) {
  return
    // Required fields must be present
    data.keys().hasAll(['deviceId', 'productId', 'platform', 'purchasedAt'])

    // Field types
    && data.deviceId is string
    && data.productId is string
    && data.platform  is string

    // Only known product IDs are accepted
    && data.productId == 'mathchamp_pro'

    // Only known platforms
    && data.platform in ['android', 'ios']

    // No extra fields beyond what the app writes
    && data.keys().hasOnly([
         'deviceId', 'productId', 'purchaseId',
         'platform', 'purchasedAt', 'transactionDate'
       ]);
}
